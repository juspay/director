{
  "name": "director",
  "version": "1.0.0",
  "description": "AI Video Production Pipeline — TypeScript agents powered by Neurolink",
  "type": "module",
  "main": "dist/pipeline/runner.js",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/pipeline/runner.ts",
    "score": "tsx src/agents/video-scorer.ts",
    "analyze": "tsx src/agents/scene-analyzer.ts",
    "compare": "tsx src/agents/video-comparator.ts",
    "direct": "tsx src/agents/creative-director.ts",
    "observe": "tsx src/observability/super-observer.ts",
    "report": "tsx src/observability/reporter.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@juspay/neurolink": "^9.30.0",
    "dotenv": "^16.4.0",
    "express": "^4.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
