{
  "name": "director",
  "version": "1.0.0",
  "description": "AI Video Production Pipeline — TypeScript agents powered by Neurolink",
  "type": "module",
  "main": "src/pipeline/runner.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --import tsx src/pipeline/runner.ts",
    "score": "node --import tsx src/agents/video-scorer.ts",
    "analyze": "node --import tsx src/agents/scene-analyzer.ts",
    "compare": "node --import tsx src/agents/video-comparator.ts",
    "fidelity": "node --import tsx src/agents/fidelity-gate.ts",
    "ref-pilot": "node --import tsx src/generators/replicate-reference.ts",
    "gate": "node --import tsx src/scoring/regression-gate.ts",
    "direct": "node --import tsx src/agents/creative-director.ts",
    "observe": "node --import tsx src/observability/super-observer.ts",
    "report": "node --import tsx src/observability/reporter.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "export:project": "tsx src/rendering/project-export.ts",
    "test:unit": "node --import tsx --test tests/utils/*.test.ts tests/policies/*.test.ts tests/schemas/*.test.ts tests/pipeline/*.test.ts tests/observability/*.test.ts tests/scoring/*.test.ts tests/rendering/*.test.ts tests/generators/*.test.ts tests/agents/*.test.ts tests/avatar/*.test.ts tests/backlot/*.test.ts",
    "test:python": "node --import tsx --test tests/scripts/*.test.ts",
    "test:tier-0": "bash scripts/test-tier-0.sh",
    "dashboard": "node --import tsx src/agents/dashboard-generator.ts",
    "backlot": "node --import tsx src/backlot/server.ts"
  },
  "dependencies": {
    "@juspay/neurolink": "^10.12.9",
    "dotenv": "^17.4.2",
    "execa": "^10.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.3.6"
  },
  "overrides": {
    "unicorn-magic": "0.4.0",
    "protobufjs": "^7.6.4",
    "@hono/node-server": "^1.19.14",
    "hono": "^4.13.2",
    "fastify": "^5.8.5",
    "@xmldom/xmldom": "^0.8.12",
    "mathjs": "^15.2.0",
    "uuid": "^11.1.1",
    "@opentelemetry/core": "^2.8.0",
    "find-my-way": "^9.8.0"
  },
  "devDependencies": {
    "@google/genai": "2.17.0",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
