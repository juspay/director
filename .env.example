# Director — Environment Variables
# Copy to .env and fill in values: cp .env.example .env

# ─── AI Model (Neurolink) ────────────────────────────────────
# MODEL=gemini-2.5-flash
# VERTEX_PROJECT=your-gcp-project
# VERTEX_LOCATION=us-central1

# ─── TTS Providers (pick one or more) ────────────────────────
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=1qEiC6qsybMkmnNdVMbK
OPENAI_API_KEY=
FISH_AUDIO_API_KEY=
# Edge-TTS requires no API key (uses edge-tts CLI)

# ─── Video Generation (pick one) ─────────────────────────────
KLING_API_KEY=
# KLING_API_BASE=https://api.klingai.com
RUNWAY_API_KEY=
# RUNWAY_API_BASE=https://api.runwayml.com/v1
# RUNWAY_API_VERSION=2024-11-06
GOOGLE_CLOUD_PROJECT=          # Required for Veo
# Veo also needs: gcloud auth application-default login

# ─── Music Generation ────────────────────────────────────────
GEMINI_API_KEY=                # Required for Lyria
BEATOVEN_API_KEY=
# NumPy synthesis requires no API key (Python subprocess)

# ─── Avatar Generation ────────────────────────────────────────
DID_API_KEY=                   # D-ID (Base64 encoded)
REPLICATE_API_TOKEN=           # MuseTalk via Replicate

# ─── Distribution ────────────────────────────────────────────
LATE_API_KEY=                  # Late.dev social publishing
MUX_TOKEN_ID=                  # Mux video hosting
MUX_TOKEN_SECRET=

# ─── Remotion (optional Lambda rendering) ─────────────────────
# REMOTION_FUNCTION_NAME=
# REMOTION_SERVE_URL=

# ─── Rate Limiting ────────────────────────────────────────────
# DELAY_MS=2000
# MAX_RETRIES=5
# RETRY_BASE_DELAY_MS=10000

# ─── Scoring Thresholds ──────────────────────────────────────
# VIDEO_SCORE_TARGET=9.0
# SCRIPT_SCORE_TARGET=9.0
# VMAF_THRESHOLD=2.0
# VIDEO_SIZE_THRESHOLD=52428800

# ─── Observability ────────────────────────────────────────────
# REPORTER_INTERVAL_MS=40000

# ─── Observability (NeuroLink Langfuse + OpenTelemetry) ─────
# Enable Langfuse tracing for every NeuroLink generate() call.
# Get keys at https://cloud.langfuse.com/ → project settings → API keys
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
