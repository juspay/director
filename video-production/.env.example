# Tara Announcement Video — Required Environment Variables
# Copy this to .env and fill in your API keys.

# ---------- ElevenLabs (Voiceover + Music) ----------
# Get your API key from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Voice ID for Tara's narration (pre-selected warm female voice)
ELEVENLABS_VOICE_ID=1qEiC6qsybMkmnNdVMbK

# ---------- HeyGen (Avatar Animation) ----------
# Get your API key from: https://app.heygen.com/settings?nav=API
HEYGEN_API_KEY=your_heygen_api_key_here

# ---------- Runway (Cinematic B-roll) ----------
# Get your API key from: https://app.runwayml.com/settings/api-keys
RUNWAY_API_KEY=your_runway_api_key_here

# ---------- Asset Paths (Optional — defaults are pre-configured) ----------
# TARA_MASCOT_SQUARE=/Users/sachinsharma/Downloads/tara-neurolink-square.png
# TARA_MASCOT_PORTRAIT=/Users/sachinsharma/Downloads/tara-neurolink.png
# SCREENSHOT_DIR=/Users/sachinsharma/Desktop
